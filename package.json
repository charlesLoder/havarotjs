{
  "name": "havarotjs",
  "version": "0.25.5",
  "description": "A Typescript package for syllabic data about Hebrew text",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./word": {
      "types": "./dist/word.d.ts",
      "import": "./dist/word.js",
      "require": "./dist/word.js",
      "default": "./dist/word.js"
    },
    "./syllable": {
      "types": "./dist/syllable.d.ts",
      "import": "./dist/syllable.js",
      "require": "./dist/syllable.js",
      "default": "./dist/syllable.js"
    },
    "./cluster": {
      "types": "./dist/cluster.d.ts",
      "import": "./dist/cluster.js",
      "require": "./dist/cluster.js",
      "default": "./dist/cluster.js"
    },
    "./char": {
      "types": "./dist/char.d.ts",
      "import": "./dist/char.js",
      "require": "./dist/char.js",
      "default": "./dist/char.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "require": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "build": "tsc --project .config/tsconfig.json",
    "watch": "tsc --watch --project .config/tsconfig.json",
    "test": "vitest --watch=false",
    "format": "prettier --config .config/.prettierrc.json --write 'src/**/*.ts' 'test/**/*.ts'",
    "format-check": "prettier --config .config/.prettierrc.json --list-different 'src/**/*.ts' 'test/**/*.ts'",
    "lint": "eslint --config .config/eslint.config.mjs .",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "./changelog.sh && npm run format && npm run lint && npm test",
    "postversion": "git push && git push --tags",
    "docs": "NODE_ENV=production astro build --config ./docs/astro.config.mjs",
    "docs:dev": "astro dev --config ./docs/astro.config.mjs",
    "update": " npm-check-updates -u"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/charlesLoder/havarotjs.git"
  },
  "bugs": {
    "url": "https://github.com/charlesLoder/havarotjs/issues"
  },
  "homepage": "https://github.com/charlesLoder/havarotjs",
  "keywords": [
    "hebrew",
    "syllable"
  ],
  "author": "Charles Loder",
  "license": "MIT",
  "devDependencies": {
    "@astrojs/starlight": "^0.35.2",
    "@eslint/js": "^9.35.0",
    "astro": "^5.13.7",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "npm-check-updates": "^18.1.0",
    "prettier": "^3.6.2",
    "starlight-typedoc": "^0.21.3",
    "typedoc": "^0.28.12",
    "typedoc-plugin-markdown": "4.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
